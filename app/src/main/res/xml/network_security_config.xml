<?xml version="1.0" encoding="utf-8"?>
<!--
    Cleartext (plain HTTP) is permitted here because self-hosted WebDAV servers are entered in the app settings
    and this file is fixed at build time (no CIDR ranges, no runtime changes). The actual rule is enforced in code
    by com.toolsboox.fi.CleartextGuard: plain HTTP only to Tailscale and home network addresses, everything else
    must use HTTPS. Keep server addresses out of this file, the repository is public.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
